{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm run build:wasm && vite",
    "build": "pnpm run build:wasm && pnpm run build:app",
    "build:wasm": "wasm-pack build ./wasm --target bundler --out-dir ../src/wasm-pkg",
    "build:app": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@unpic/react": "^1.0.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "reagraph": "^4.32.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "^4.3.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.63.0",
    "unocss": "^66.7.5",
    "vite": "^7.3.6",
    "vite-plugin-wasm": "^3.6.0"
  }
}
