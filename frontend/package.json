{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm run build:wasm && vite",
    "build": "pnpm run build:wasm && pnpm run build:app",
    "build:wasm": "wasm-pack build ./wasm --target bundler --out-dir ../src/wasm-pkg",
    "build:app": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@unpic/react": "^1.0.2",
    "framer-motion": "^13.4.0",
    "react": ">=19.2.8 <19.3.0",
    "react-dom": ">=19.2.8 <19.3.0",
    "reagraph": "^4.32.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "unocss": "^66.10.5",
    "vite": "^8.3.0",
    "vite-plugin-wasm": "^3.6.0"
  }
}
